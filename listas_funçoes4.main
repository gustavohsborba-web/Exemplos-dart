double media(double n1, double n2) {
  return (n1 + n2) / 2;
}

String situacao(double nota) {
  if (nota >= 7) {
    return "Aprovado";
  } else {
    return "Reprovado";
  }
}

void main() {
  double media1 = media(8, 6);
  print("Média: $media1 - Situação: ${situacao(media1)}");

  double media2 = media(5, 6);
  print("Média: $media2 - Situação: ${situacao(media2)}");
}
