void main() {
  // ===== ENTRADAS =====
  int idade = 70;
  // ====================
  if (idade <= 11) {
    print("Você ainda é criança!");
  } else if (idade > 11 && idade < 18) {
    print("Você  é adolescente!");
  } else if (idade >= 18 && idade < 60) {
    print("Você é adulto!");
  } else {
    print("Você é idoso!");
  }
}
