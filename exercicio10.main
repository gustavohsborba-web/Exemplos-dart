void main() {
  // ===== ENTRADAS =====
  int nota1 = 9;
  int nota2 = 3;
  // ====================
  double media = (nota1 + nota2) / 2;

  if (media >= 7) {
    print("APROVADO!!!!");
    print("Sua média foi de: $media");
  } else if (media < 7 && media >= 5) {
    print("RECUPERAÇÃO");
    print("Sua média foi de: $media");
  } else {
    print("REPROVADO");
    print("Sua média foi de: $media");
  }
  ;
}
